---
import { Image } from 'astro:assets';
import logo from '../assets/kings/logo.png';
import mark from '../assets/brand/calcup-mark.svg';
import { calcupNav, nav } from '../data/site';
import { calcupUrl, url } from '../lib/url';

// Kings pages get the Kings header. CalCup pages get the CalCup header, with a thin Kings bar above it.
const path = Astro.url.pathname;
const inCalcup = path.startsWith(calcupUrl());
const isActive = (href: string) => (href === '' ? path === url('') : path.startsWith(url(href)));
const isCalcupActive = (href: string) => (href === '' ? path === calcupUrl() : path.startsWith(calcupUrl(href)));

const links = inCalcup
  ? calcupNav.map((item) => ({ href: calcupUrl(item.href), label: item.label, active: isCalcupActive(item.href) }))
  : nav.map((item) => ({ href: url(item.href), label: item.label, active: isActive(item.href) }));
const cta = inCalcup ? { href: calcupUrl('register/'), label: 'Register' } : { href: url('support/'), label: 'Support us' };
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-ink/85 backdrop-blur">
  {
    inCalcup && (
      <div class="border-b border-line/70 bg-espresso">
        <div class="wrap flex h-9 items-center justify-between gap-4 text-sm">
          <a href={url('')} class="flex min-w-0 items-center gap-2 text-cream/80 hover:text-gold">
            <Image src={logo} alt="" width={40} class="h-6 w-auto shrink-0" />
            <span class="truncate">
              A <span class="font-semibold text-cream">Bay Area Kings</span> event
            </span>
          </a>
          <nav class="hidden items-center gap-5 md:flex" aria-label="Bay Area Kings">
            {nav.map((item) => (
              <a href={url(item.href)} class="font-display tracking-wider text-cream/60 uppercase hover:text-gold">
                {item.label}
              </a>
            ))}
          </nav>
          <a href={url('')} class="shrink-0 font-display font-semibold tracking-wider text-gold uppercase hover:underline md:hidden">
            Kings site →
          </a>
        </div>
      </div>
    )
  }

  <div class="wrap flex h-16 items-center justify-between gap-6">
    {
      inCalcup ? (
        <a href={calcupUrl()} class="flex items-center gap-3" aria-label="CalCup 2027 overview">
          <img src={mark.src} alt="" class="h-9 w-auto" />
          <span class="leading-none">
            <span class="block font-display text-2xl font-semibold tracking-[0.18em] text-cream">CALCUP</span>
            <span class="block font-display text-[0.65rem] font-semibold tracking-[0.35em] text-gold">T10 · 2027</span>
          </span>
        </a>
      ) : (
        <a href={url('')} class="flex items-center gap-3" aria-label="Bay Area Kings home">
          <Image src={logo} alt="" width={84} class="h-11 w-auto" />
          <span class="leading-none">
            <span class="block font-display text-[0.65rem] font-semibold tracking-[0.35em] text-gold">BAY AREA</span>
            <span class="block font-display text-2xl font-semibold tracking-[0.18em] text-cream">KINGS</span>
          </span>
        </a>
      )
    }

    <nav class="hidden items-center gap-1 lg:flex" aria-label={inCalcup ? 'CalCup 2027' : 'Main'}>
      {
        links.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? 'page' : undefined}
            class="rounded-full px-4 py-2 font-display text-base font-semibold tracking-wider text-cream/80 uppercase transition hover:text-gold aria-[current=page]:text-gold"
          >
            {item.label}
          </a>
        ))
      }
      <a href={cta.href} class="btn-gold ml-2 !px-5 !py-2 !text-base">{cta.label}</a>
    </nav>

    <div class="flex items-center gap-2 lg:hidden">
      {inCalcup && <a href={cta.href} class="btn-gold !px-4 !py-1.5 !text-sm">{cta.label}</a>}
      <details class="group relative">
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-line px-4 py-2 font-display font-semibold tracking-wider uppercase [&::-webkit-details-marker]:hidden">
          Menu
          <svg class="size-4 transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z" /></svg>
        </summary>
        <nav class="card absolute right-0 mt-3 flex w-64 flex-col p-2 shadow-2xl" aria-label={inCalcup ? 'CalCup 2027' : 'Main'}>
          {
            links.map((item) => (
              <a
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
                class="rounded-xl px-4 py-3 font-display text-lg font-semibold tracking-wider uppercase hover:bg-white/5 aria-[current=page]:text-gold"
              >
                {item.label}
              </a>
            ))
          }
          {
            inCalcup ? (
              <a href={url('')} class="mt-1 rounded-xl border-t border-line px-4 py-3 font-display text-base font-semibold tracking-wider text-gold uppercase hover:bg-white/5">
                ← Bay Area Kings site
              </a>
            ) : (
              <a href={calcupUrl()} class="rounded-xl px-4 py-3 font-display text-lg font-semibold tracking-wider text-gold uppercase hover:bg-white/5">
                CalCup 2027 →
              </a>
            )
          }
          <a href={cta.href} class="btn-gold mt-2 justify-center">{cta.label}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
