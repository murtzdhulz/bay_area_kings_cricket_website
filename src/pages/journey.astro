---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import huddle from '../assets/kings/huddle.webp';
import { journey } from '../data/journey';
import { getTournaments, tournamentHref } from '../lib/tournaments';
import { url } from '../lib/url';

const tournaments = await getTournaments();
const steps = journey.map((s) => {
  const t = s.tournament ? tournaments.find((x) => x.id === s.tournament) : undefined;
  return { ...s, href: t && tournamentHref(t), image: t?.data.image, imageAlt: t?.data.imageAlt ?? '' };
});
---

<Base title="Our Journey" description="How Bay Area Kings grew from a handful of players into a cricket community, and now a tournament host.">
  <PageHeader
    eyebrow="Our journey"
    title="From a handful to a home team"
    intro="How a few friends playing on weekends became a team that travels, wins, and now hosts its own tournament."
  />

  <section class="wrap pt-16">
    <ol class="relative ml-3 border-l-2 border-gold/30 sm:ml-6">
      {
        steps.map((s) => (
          <li class="relative pb-14 pl-8 last:pb-0 sm:pl-12">
            <span class="absolute top-1 -left-[0.6rem] size-4 rounded-full border-2 border-gold bg-ink" aria-hidden="true" />
            <p class="eyebrow">{s.when}</p>
            <div class:list={['mt-2 grid gap-6', s.image && 'md:grid-cols-[1fr_20rem]']}>
              <div>
                <h2 class="display text-4xl">{s.title}</h2>
                <p class="mt-3 max-w-2xl text-lg text-cream/75">{s.body}</p>
                {s.draft && <p class="mt-2 text-xs tracking-widest text-muted uppercase">Draft · details to confirm</p>}
                {s.href && (
                  <a href={s.href} class="mt-4 inline-block font-display font-semibold tracking-widest text-gold uppercase hover:underline">
                    {s.tournament === 'calcup-2027' ? 'Go to CalCup 2027 →' : 'Tournament story →'}
                  </a>
                )}
              </div>
              {s.image && <Image src={s.image} alt={s.imageAlt} width={640} class="rounded-2xl border border-line" />}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap pt-20">
    <div class="card grid items-center gap-8 overflow-hidden md:grid-cols-2">
      <Image src={huddle} alt="Cricket players joining hands in a team huddle" width={900} class="h-full object-cover" />
      <div class="p-8">
        <p class="eyebrow">Have a story to add?</p>
        <h2 class="display mt-2 text-4xl">Help us tell it</h2>
        <p class="mt-4 text-cream/75">
          This page is a first draft. If you have photos, dates or memories from the early days, send them to the team and we’ll add them here.
        </p>
        <a href={url('team/')} class="btn-ghost mt-6">Meet the players</a>
      </div>
    </div>
  </section>
</Base>
